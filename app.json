{
  "expo": {
    "name": "NoorLifeApp",
    "slug": "NoorLifeApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "noorlifeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.NoorLifeApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.NoorLifeApp",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./assets/fonts/Poppins_400Regular.ttf",
              "./assets/fonts/Poppins_500Medium.ttf",
              "./assets/fonts/Poppins_600SemiBold.ttf",
              "./assets/fonts/Poppins_700Bold.ttf"
            ]
          }
        }
      ],
      "./plugins/with-imageless-native-splash",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFFFD"
        }
      ],
      "expo-secure-store",
      "./plugins/with-mailto-package-visibility",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NoorLife uses your location to calculate prayer times and the direction of the Qibla for where you are. Your location stays on this device.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NoorLife asks for your photos only when you choose to import a receipt, and only reads the one you pick. The image stays on this device.",
          "cameraPermission": "NoorLife asks for your camera only when you choose to photograph a receipt. The photo stays on this device.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

# NoorLife — Supabase configuration
#
# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.
#
# Only the PUBLISHABLE (anon) key belongs here. Anything prefixed EXPO_PUBLIC_ is
# inlined into the JavaScript bundle at build time and is readable by anyone with
# the APK, so the service-role key must never be set as an EXPO_PUBLIC_ variable
# or placed in this application at all.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
